{
  "1": {
    "class_type": "LoadImage",
    "inputs": { "image": "REPLACE_WITH_UPLOADED_IMAGE.png" }
  },
  "1b": {
    "class_type": "ImageScale",
    "inputs": {
      "image": ["1", 0],
      "upscale_method": "lanczos",
      "width": 576,
      "height": 1024,
      "crop": "center"
    }
  },
  "2": {
    "class_type": "VHS_LoadVideo",
    "inputs": {
      "video": "REPLACE_WITH_UPLOADED_POSE_VIDEO.mp4",
      "force_rate": 15,
      "custom_width": 576,
      "custom_height": 1024,
      "frame_load_cap": 72,
      "skip_first_frames": 0,
      "select_every_nth": 1
    }
  },
  "3": {
    "class_type": "DownloadAndLoadMimicMotionModel",
    "inputs": {
      "model": "MimicMotionMergedUnet_1-1-fp16.safetensors",
      "precision": "fp16"
    }
  },
  "4": {
    "class_type": "MimicMotionGetPoses",
    "inputs": {
      "ref_image": ["1b", 0],
      "pose_images": ["2", 0],
      "include_body": true,
      "include_hand": true,
      "include_face": true
    }
  },
  "5": {
    "class_type": "MimicMotionSampler",
    "inputs": {
      "mimic_pipeline": ["3", 0],
      "ref_image": ["1b", 0],
      "pose_images": ["4", 1],
      "steps": 25,
      "cfg_min": 2.0,
      "cfg_max": 2.0,
      "seed": 0,
      "fps": 15,
      "noise_aug_strength": 0.0,
      "context_size": 16,
      "context_overlap": 6,
      "keep_model_loaded": true
    }
  },
  "6": {
    "class_type": "MimicMotionDecode",
    "inputs": {
      "mimic_pipeline": ["3", 0],
      "samples": ["5", 0],
      "decode_chunk_size": 4
    }
  },
  "7": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["6", 0],
      "frame_rate": 15,
      "loop_count": 0,
      "filename_prefix": "MimicMotion",
      "format": "video/h264-mp4",
      "pingpong": false,
      "save_output": true
    }
  }
}
